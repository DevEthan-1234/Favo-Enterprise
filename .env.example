# Supabase → Project Settings → API (or the "Connect" button)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Email of the admin user you create in Supabase → Authentication → Users.
# The admin types the username "favoenterprise" on the site; it signs in as this email.
VITE_ADMIN_EMAIL=favoenterprise@favoenterprise.app
